# Keep the Docker build context small and reproducible.
# Everything that is not needed by docker/Dockerfile is excluded here.
.git
.github
.idea
*.iml
*.ipr
*.iws

# Local build output (the image is built inside the dev stage)
build/
**/build/
out/
.gradle
**/.gradle
target/

# Not needed inside the image
src/test/
*.md
Dockerfile
.dockerignore
.gitignore
gradlew.bat
